FROM node:22-alpine

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./
COPY apps/web/package*.json ./apps/web/
COPY packages/shared/package*.json ./packages/shared/

# Install dependencies
RUN npm install

# Copy source code
COPY . .

EXPOSE 3000

CMD ["npm", "run", "start", "--prefix", "apps/web"]
