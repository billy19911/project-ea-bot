{
  "name": "project-ea-bot",
  "version": "1.0.0",
  "description": "Monorepo untuk EA Bot - Next.js + Node.js + Python FastAPI",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "install:all": "npm install",
    "setup": "node scripts/setup.js",
    "config:validate": "node config-validate.js",
    "up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-all.ps1",
    "status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status.ps1",
    "token": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/get-token.ps1"
  },
  "devDependencies": {
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "postcss": "^8.5.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.2"
  }
}
