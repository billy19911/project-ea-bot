# ============================================================================
# Git ignore untuk project-ea-bot monorepo
# ============================================================================
node_modules/
.env
.env.local
.env.runtime
logs/
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
*.tgz
.cache/
.ruff/
.mypy_cache/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs (jika log ditulis ke file, bukan stdout)
*.log

# Next.js build output
.next/
# Per-port dist dirs from apps/web/next.config.mjs (.next-<port>, .next-dev-<port>)
.next-*/
apps/web/.next-*/

# next-env.d.ts is regenerated by `next dev`/`next build` and its reference
# points at the ACTIVE distDir (.next-<port> or .next-dev-<port>), so with
# per-port isolation it churns on every port/mode. Next.js docs: managed by
# Next.js, add to .gitignore and untrack it. Regenerated automatically.
next-env.d.ts

# Tool skill caches (prisma composer dll)
apps/api/.agents/
apps/api/.claude/
apps/api/.cursor/
apps/api/.devin/

# Secrets / credentials
*.pem
*.key
secrets/

# Next.js / TS build artifacts
*.tsbuildinfo
apps/web/.next/

# Runtime settings yang ditulis operator dari dashboard (ide #7) — state, bukan kode.
services/python/runtime_settings.json
services/python/research_state.jsonl

# Test artifacts
temp_pytest/
test_ea_bot.db

# Keep the final audit report tracked even though /build is ignored.
!docs/build/
!docs/build/**


# Runtime state (MT5 terminal selection)
services/python/mt5_selected.json

# Env backups may contain live bot tokens — never commit them.
.env.runtime.bak-*
