node_modules/
.env
.env.local
.env.runtime
logs/
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
*.tgz
.cache/
.ruff/
.mypy_cache/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs (jika log ditulis ke file, bukan stdout)
*.log

# Next.js build output
.next/

# Tool skill caches (prisma composer dll)
apps/api/.agents/
apps/api/.claude/
apps/api/.cursor/
apps/api/.devin/

# Secrets / credentials
*.pem
*.key
secrets/

# Next.js / TS build artifacts
*.tsbuildinfo
apps/web/.next/

# Runtime settings yang ditulis operator dari dashboard (ide #7) — state, bukan kode.
services/python/runtime_settings.json

# Test artifacts
temp_pytest/
test_ea_bot.db

# Keep the final audit report tracked even though /build is ignored.
!docs/build/
!docs/build/**

