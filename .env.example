# =============================================================================
# Environment Variables — project-ea-bot
# =============================================================================
# Salin file ini ke .env dan isi nilai yang sesuai untuk environment kamu.
#
#   cp .env.example .env
#
# Ringkasan variable wajib (must be set sebelum startup):
#   SERVICE_NAME, DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, JWT_SECRET
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
SERVICE_NAME=api

# ---------------------------------------------------------------------------
# Logging (shared across all services)
# ---------------------------------------------------------------------------
# Level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database — PostgreSQL (shared by Node.js API dan Python service)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eabot
DB_USER=eaBot
DB_PASSWORD=changeme-in-production
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis (shared — queues, cache, session)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=changeme-generate-a-random-32char-string-in-production
JWT_EXPIRY=24h

# ---------------------------------------------------------------------------
# External APIs (isi saat di-integrasikan)
# ---------------------------------------------------------------------------
EXTERNAL_API_KEY=
EXTERNAL_API_BASE_URL=

# ---------------------------------------------------------------------------
# LLM / AI Gateway (9Router, OpenAI-compatible)
# ---------------------------------------------------------------------------
# API key for the 9Router gateway (falls back to OPENAI_API_KEY when unset).
NINE_ROUTER_API_KEY=
# Gateway base URL. Point this at your local 9Router proxy when self-hosting,
# e.g. NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_BASE_URL=https://api.9router.com/v1

# ---------------------------------------------------------------------------
# Python Service
# ---------------------------------------------------------------------------
PYTHON_SERVICE_HOST=0.0.0.0
PYTHON_SERVICE_PORT=8000

# ---------------------------------------------------------------------------
# MetaTrader 5 (Windows only)
# ---------------------------------------------------------------------------
# Attach to a RUNNING MT5 terminal for real market data (read-only):
#   MT5_LIVE_DATA=true
# When enabled the connector calls MetaTrader5.initialize() (no credentials —
# it attaches to the terminal already logged in) and order execution is
# DISABLED at the connector and engine level (live data, never live orders).
# Requires: pip install MetaTrader5 (Windows only; ignored on other platforms).
MT5_LIVE_DATA=false

# Multi-terminal registry (Run 24). Path to the JSON file listing MT5 terminals
# (id, label, terminal64.exe path, "execution" flag). Defaults to
# services/python/mt5_terminals.json when unset. Running terminals are also
# auto-detected via psutil; only terminals marked "execution": true can ever be
# armed for real order execution from the dashboard (and arming is always a
# manual, explicit step — it starts OFF and is never persisted).
# MT5_TERMINALS_CONFIG=C:\path\to\mt5_terminals.json

# ---------------------------------------------------------------------------
# Telegram reports (Fase 5) — optional; kosong = fitur report mati
# ---------------------------------------------------------------------------
# Buat bot via @BotFather untuk mendapatkan token, lalu dapatkan chat id Anda
# (mis. lewat @userinfobot). Tanpa token sistem tetap jalan — hanya report mati.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
ENABLE_TRACING=false

# =============================================================================
# Trading configuration (diwarisi dari agent sebelumnya — kept for reference)
# =============================================================================
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
TRADING_PAIR=BTC/USDT
TIMEFRAME=1h
DRY_RUN=true
HOST=0.0.0.0
DATABASE_URL=postgresql://user:***@localhost:5432/eabot
