# =============================================================================
# Environment Variables — project-ea-bot
# =============================================================================
# Salin file ini ke .env dan isi nilai yang sesuai untuk environment kamu.
#
#   cp .env.example .env
#
# Ringkasan variable wajib (must be set sebelum startup):
#   SERVICE_NAME, DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, JWT_SECRET
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
SERVICE_NAME=api

# ---------------------------------------------------------------------------
# Logging (shared across all services)
# ---------------------------------------------------------------------------
# Level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database — PostgreSQL (shared by Node.js API dan Python service)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eabot
DB_USER=eaBot
DB_PASSWORD=changeme-in-production
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis (shared — queues, cache, session)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=changeme-generate-a-random-32char-string-in-production
JWT_EXPIRY=24h

# ---------------------------------------------------------------------------
# External APIs (isi saat di-integrasikan)
# ---------------------------------------------------------------------------
EXTERNAL_API_KEY=
EXTERNAL_API_BASE_URL=

# ---------------------------------------------------------------------------
# LLM / AI Gateway (9Router, OpenAI-compatible)
# ---------------------------------------------------------------------------
# API key for the 9Router gateway (falls back to OPENAI_API_KEY when unset).
NINE_ROUTER_API_KEY=
# Gateway base URL. Point this at your local 9Router proxy when self-hosting,
# e.g. NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_BASE_URL=https://api.9router.com/v1

# ---------------------------------------------------------------------------
# Python Service
# ---------------------------------------------------------------------------
# HOST/PORT are the variables the Python service reads (config.py: alias HOST /
# PORT). Default HOST is 127.0.0.1 (loopback). Only set HOST=0.0.0.0 if you have
# applied authentication (PYTHON_API_KEY) AND put the service behind a trusted
# network boundary — an unauthenticated 0.0.0.0 bind exposes the arm switch.
HOST=127.0.0.1
PORT=8000
# Legacy aliases (NOT read by config.py) — kept only for older launcher scripts.
# PYTHON_SERVICE_HOST=127.0.0.1
# PYTHON_SERVICE_PORT=8000

# ---------------------------------------------------------------------------
# MetaTrader 5 (Windows only)
# ---------------------------------------------------------------------------
# Attach to a RUNNING MT5 terminal for real market data (read-only):
#   MT5_LIVE_DATA=true
# When enabled the connector calls MetaTrader5.initialize() (no credentials —
# it attaches to the terminal already logged in) and order execution is
# DISABLED at the connector and engine level (live data, never live orders).
# Requires: pip install MetaTrader5 (Windows only; ignored on other platforms).
MT5_LIVE_DATA=false

# Multi-terminal registry (Run 24). Path to the JSON file listing MT5 terminals
# (id, label, terminal64.exe path, "execution" flag). Defaults to
# services/python/mt5_terminals.json when unset. Running terminals are also
# auto-detected via psutil; only terminals marked "execution": true can ever be
# armed for real order execution from the dashboard (and arming is always a
# manual, explicit step — it starts OFF and is never persisted).
# MT5_TERMINALS_CONFIG=C:\path\to\mt5_terminals.json

# ---------------------------------------------------------------------------
# Telegram reports (Fase 5) — optional; kosong = fitur report mati
# ---------------------------------------------------------------------------
# Buat bot via @BotFather untuk mendapatkan token, lalu dapatkan chat id Anda
# (mis. lewat @userinfobot). Tanpa token sistem tetap jalan — hanya report mati.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# ---------------------------------------------------------------------------
# Market feed loop (Fase 6) — default OFF; operator menyalakan eksplisit
# ---------------------------------------------------------------------------
# Membaca OHLC MT5 (read-only) → deteksi event → queue → scheduler menganalisis
# sendiri. Default false: sistem hanya menganalisis saat dipicu manual.
# MARKET_FEED_ENABLED=false
# MARKET_FEED_SYMBOLS=XAUUSD
# MARKET_FEED_TIMEFRAME=M5
# MARKET_FEED_INTERVAL_S=60
# Anti-spam: tipe event yang sama tidak di-emit ulang sebelum jendela ini (detik).
# MARKET_FEED_EVENT_COOLDOWN_S=300

# ---------------------------------------------------------------------------
# Telegram inbound commands (opsional) — chat ke bot → balasan read-only
# ---------------------------------------------------------------------------
# Telegram hanya mengizinkan SATU konsumer getUpdates per bot. Jika token
# report sudah dipakai bot lain (mis. asisten Anda), buat bot KEDUA via
# @BotFather untuk perintah masuk dan isi TELEGRAM_POLLER_BOT_TOKEN.
# TELEGRAM_POLLER_ENABLED=false
# TELEGRAM_POLLER_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Telegram report digest (anti-spam) — banyak siklus jadi SATU pesan ringkas
# ---------------------------------------------------------------------------
# Siklus otonom (market feed) digabung jadi satu pesan per jendela waktu (atau
# per N siklus, mana dulu). Keputusan BUY/SELL dan trade tereksekusi selalu
# dikirim segera (bypass digest). Set false = kembali kirim per siklus.
# TELEGRAM_DIGEST_ENABLED=true
# TELEGRAM_DIGEST_WINDOW_S=600
# TELEGRAM_DIGEST_MAX_ITEMS=15

# ---------------------------------------------------------------------------
# Learning feedback (Fase 7) — persist lessons lintas restart (JSONL)
# ---------------------------------------------------------------------------
# Path file JSONL untuk lessons (default: services/python/logs/lessons.jsonl).
# LESSON_STORE_PATH=C:\path\to\lessons.jsonl

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
ENABLE_TRACING=false

# ---------------------------------------------------------------------------
# Realtime live stream (WebSocket) — harga + P&L posisi di dashboard
# ---------------------------------------------------------------------------
# Node API menyiarkan tick harga & P&L posisi via WebSocket di path /ws.
# Interval poll upstream (ms) — server mem-poll SEKALI per interval, dibagi ke
# semua klien (bukan per-tab). Default 2500ms.
# LIVE_INTERVAL_MS=2500
#
# URL WS dari sisi browser. Jika kosong, web menurunkan otomatis dari
# NEXT_PUBLIC_API_URL, atau ke ws://<host-sekarang>:<NEXT_PUBLIC_WS_PORT>.
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3789/ws
# NEXT_PUBLIC_WS_PORT=3789

# =============================================================================
# Trading configuration (diwarisi dari agent sebelumnya — kept for reference)
# =============================================================================
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
TRADING_PAIR=BTC/USDT
TIMEFRAME=1h
DRY_RUN=true
HOST=127.0.0.1
DATABASE_URL=postgresql://user:***@localhost:5432/eabot

# -----------------------------------------------------------------------------
# Python service authentication (audit P0-1)
# -----------------------------------------------------------------------------
# When PYTHON_API_KEY is set, the Python FastAPI service requires it on every
# request (X-API-Key header or Authorization: Bearer) except the public probes
# below. When unset the service runs UNAUTHENTICATED (local dev only) and binds
# loopback (HOST=127.0.0.1). Production MUST set this key.
# PYTHON_API_KEY=change-me-to-a-long-random-secret
# PYTHON_API_PUBLIC_PATHS=/health,/metrics,/
